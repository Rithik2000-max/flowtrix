# ========================================
# WeKan Configuration
# ========================================

# MongoDB Connection (Required)
MONGO_URL=mongodb://flowtrix-db:27017/flowtrix?replicaSet=rs0
MONGO_OPLOG_URL=mongodb://flowtrix-db:27017/local?replicaSet=rs0


ROOT_URL=http://localhost:3004
PORT=8080
WITH_API=true
WRITABLE_PATH=/data
DEBUG=false

# Security & Accounts
PASSWORD_LOGIN_ENABLED=true
ACCOUNTS_EMAIL_VERIFICATION=false
ACCOUNTS_COMMON_LOGIN_EXPIRATION_IN_DAYS=90
ACCOUNTS_LOCKOUT_KNOWN_USERS_FAILURES_BEFORE=3
ACCOUNTS_LOCKOUT_KNOWN_USERS_PERIOD=60
ACCOUNTS_LOCKOUT_KNOWN_USERS_FAILURE_WINDOW=15

# Optional Features (uncomment and set as needed)
# OAUTH2_ENABLED=false
# OAUTH2_CLIENT_ID=your_client_id_here
# OAUTH2_SECRET=your_secret_here
# LDAP_ENABLE=false

# Email (if you want notifications)
# MAIL_URL=smtp://user:password@smtp.example.com:587

MAIL_URL=smtp://localhost:25

# Matomo / Analytics (optional)
# MATOMO_ADDRESS=
# MATOMO_SITE_ID=

# Add any other WeKan settings you want here...